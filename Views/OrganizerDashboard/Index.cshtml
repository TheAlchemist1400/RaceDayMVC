@{
    ViewData["Title"] = "Organizer Dashboard";
}

<div class="container mt-5">

    <h1>Welcome, @ViewBag.DisplayName!</h1>

    <p class="text-muted">
        Welcome to your RaceDay Organizer dashboard.
        Manage your events and monitor participation.
    </p>

    <hr />

    <div class="row mt-4">

        <!-- Create and manage events -->
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">My Events</h5>
                    <p>View and manage the events you have created.</p>

                    <a asp-controller="Events"
                       asp-action="MyEvents"
                       class="btn btn-primary">
                        Manage My Events
                    </a>
                </div>
            </div>
        </div>

        <!-- Manage participants -->
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Enrolments</h5>
                    <p>Monitor participants enrolled in your events.</p>

                    <a asp-controller="Events"
                       asp-action=""
                       class="btn btn-primary">
                        Enrolments
                    </a>
                </div>
            </div>
        </div>

        <!-- Manage results -->
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">Event Results</h5>
                    <p>Manage and publish event results.</p>

                    <button class="btn btn-primary" disabled>
                        Coming Soon
                    </button>
                </div>
            </div>
        </div>

    </div>

    <hr />

    <h4>Account Information</h4>

    <p><strong>Organization:</strong> @ViewBag.DisplayName</p>
    <p><strong>Email:</strong> @ViewBag.Email</p>
    <p><strong>Account type:</strong> Organizer</p>

</div>
