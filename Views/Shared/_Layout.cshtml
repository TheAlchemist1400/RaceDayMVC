@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RaceDay.Mvc</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDay.Mvc.styles.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    RaceDay
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">

                        <!-- Public navigation -->
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>

                        @{
                            // Retrieve the logged-in user's information.
                            int? userId = Context.Session.GetInt32("UserId");
                            string? role = Context.Session.GetString("Role");
                        }

                        @if (userId != null)
                        {
                            <!-- Participant navigation -->
                            @if (role == "Participant")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="ParticipantDashboard"
                                       asp-action="Index">
                                        Participant Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Events"
                                       asp-action="Index">
                                        Browse Events
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Results"
                                       asp-action="MyResults">
                                        My Results
                                    </a>
                                </li>
                            }

                            <!-- Organizer navigation -->
                            @if (role == "Organizer")
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="OrganizerDashboard"
                                       asp-action="Index">
                                        Organizer Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-controller="Events"
                                       asp-action="MyEvents">
                                        My Events
                                    </a>
                                </li>
                            }

                            <!-- Logout -->
                            <li class="nav-item">
                                <form asp-controller="Auth"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-outline-danger ms-2">
                                        Logout
                                    </button>

                                </form>
                            </li>
                        }
                        else
                        {
                            <!-- Logged-out navigation -->
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Auth"
                                   asp-action="Login">
                                    Login
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Auth"
                                   asp-action="Register">
                                    Register
                                </a>
                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>
    </header>

    <div class="container">

        <main role="main" class="pb-3">
            @RenderBody()
        </main>

    </div>

    <footer class="border-top footer text-muted">

        <div class="container">
            &copy; 2026 - RaceDay.Mvc -
            <a asp-controller="Home" asp-action="Privacy">
                Privacy
            </a>
        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
