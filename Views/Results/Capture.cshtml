@model RaceDay.Mvc.ViewModels.CaptureResultViewModel

@{
    ViewData["Title"] = "Capture Result";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <h2>Capture Participant Result</h2>

            <p class="text-muted">
                Record the finishing details for this enrolment.
            </p>

            <div class="card mb-4">
                <div class="card-body">

                    <p>
                        <strong>Participant:</strong>
                        @ViewBag.ParticipantName
                    </p>

                    <p>
                        <strong>Activity:</strong>
                        @ViewBag.ActivityName
                    </p>

                    <p>
                        <strong>Bib Number:</strong>
                        #@ViewBag.BibNumber
                    </p>

                </div>
            </div>

            <form asp-controller="Results"
                  asp-action="Capture"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="RegistrationId" type="hidden" />
                <input asp-for="EventId" type="hidden" />

                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="FinishTime"
                           class="form-label">
                        Finish Time (HH:mm:ss)
                    </label>

                    <input asp-for="FinishTime"
                           type="time"
                           step="1"
                           class="form-control" />

                    <span asp-validation-for="FinishTime"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Position"
                           class="form-label">
                        Finishing Position
                    </label>

                    <input asp-for="Position"
                           type="number"
                           min="1"
                           class="form-control" />

                    <span asp-validation-for="Position"
                          class="text-danger"></span>
                </div>

                <input asp-for="ResultStatus" type="hidden" />

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-success">
                        Save Result
                    </button>

                    <a asp-controller="Enrolments"
                       asp-action="EventRegistrations"
                       asp-route-id="@Model.EventId"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
