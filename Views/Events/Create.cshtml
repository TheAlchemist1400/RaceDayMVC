@model RaceDay.Mvc.ViewModels.CreateEventViewModel

@{
    ViewData["Title"] = "Create Event";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">

            <h1>Create New Event</h1>

            <p class="text-muted">
                Publish a new event for participants to discover.
            </p>

            <hr />

            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
                <div class="alert alert-warning">
                    @ViewBag.ErrorMessage
                </div>
            }

            <form asp-controller="Events"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="EventsName"
                           class="form-label">
                        Event Name
                    </label>

                    <input asp-for="EventsName"
                           class="form-control"
                           placeholder="e.g. Johannesburg Marathon" />

                    <span asp-validation-for="EventsName"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="EventDate"
                           class="form-label">
                        Event Date
                    </label>

                    <input asp-for="EventDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="EventDate"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="MaxParticipants"
                           class="form-label">
                        Maximum Participants
                    </label>

                    <input asp-for="MaxParticipants"
                           type="number"
                           min="1"
                           class="form-control"
                           placeholder="e.g. 500" />

                    <span asp-validation-for="MaxParticipants"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-4">
                    <label asp-for="LocationId"
                           class="form-label">
                        Event Location
                    </label>

                    <select asp-for="LocationId"
                            class="form-select">

                        <option value="0">
                            -- Select a location --
                        </option>

                        @foreach (var location in Model.Locations)
                        {
                            <option value="@location.LocationId">
                                @location.Venue - @location.City,
                                @location.Province
                            </option>
                        }

                    </select>

                    <span asp-validation-for="LocationId"
                          class="text-danger">
                    </span>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Publish Event
                    </button>

                    <a asp-controller="Events"
                       asp-action="MyEvents"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
