@model RaceDay.Mvc.ViewModels.EventViewModel

@{
    ViewData["Title"] = "Delete Event";
}

<div class="container mt-5">

    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card shadow-sm border-danger">

                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Delete Event</h4>
                </div>

                <div class="card-body">

                    <div class="alert alert-warning">
                        <strong>Warning!</strong>

                        Are you sure you want to delete this event?
                        This action cannot be undone.
                    </div>

                    <h4>@Model.EventsName</h4>

                    <hr />

                    <p>
                        <strong>Date:</strong>
                        @Model.EventDate.ToString("dd MMMM yyyy")
                    </p>

                    <p>
                        <strong>Venue:</strong>
                        @Model.Location
                    </p>

                    <p>
                        <strong>City:</strong>
                        @Model.City, @Model.Province
                    </p>

                    <p>
                        <strong>Maximum Participants:</strong>
                        @Model.MaxParticipants
                    </p>

                    <hr />

                    <form asp-controller="Events"
                          asp-action="Delete"
                          asp-route-id="@Model.EventId"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-danger">
                            Yes, Delete Event
                        </button>

                        <a asp-controller="Events"
                           asp-action="MyEvents"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>
