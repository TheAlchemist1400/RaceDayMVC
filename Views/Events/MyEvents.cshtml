@model List<RaceDay.Mvc.ViewModels.EventViewModel>

@{
    ViewData["Title"] = "My Events";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["Success"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }
        <div>
            <h1>My Events</h1>
            <p class="text-muted">
                Manage the events published by your organization.
            </p>
        </div>

        <a asp-controller="Events"
           asp-action="Create"
           class="btn btn-primary">
            Create New Event
        </a>
    </div>

    <hr />

    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            <h5>No events found</h5>
            <p class="mb-0">
                You haven't published any events yet.
                Create your first event to get started.
            </p>
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var eventItem in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">

                    <div class="card shadow-sm h-100">

                        <div class="card-body">

                            <h5 class="card-title">
                                @eventItem.EventsName
                            </h5>

                            <hr />

                            <p>
                                <strong>Date:</strong>
                                @eventItem.EventDate.ToString("dd MMMM yyyy")
                            </p>

                            <p>
                                <strong>Venue:</strong>
                                @eventItem.Location
                            </p>

                            <p>
                                <strong>City:</strong>
                                @eventItem.City, @eventItem.Province
                            </p>

                            <p>
                                <strong>Maximum Participants:</strong>
                                @eventItem.MaxParticipants
                            </p>

                            <div class="d-flex gap-2">

                                <a asp-controller="Events"
                                   asp-action="Edit"
                                   asp-route-id="@eventItem.EventId"
                                   class="btn btn-outline-primary btn-sm">
                                    Edit
                                </a>

                                <a asp-controller="Activities"
                                   asp-action="Create"
                                   asp-route-eventId="@eventItem.EventId"
                                   class="btn btn-outline-success btn-sm">
                                    Add Activity
                                </a>

                                <a asp-controller="Events"
                                   asp-action="Delete"
                                   asp-route-id="@eventItem.EventId"
                                   class="btn btn-outline-danger btn-sm">
                                    Delete
                                </a>

                                
                                <a asp-controller="Enrolments"
                                   asp-action="EventRegistrations"
                                   asp-route-id="@eventItem.EventId"
                                   class="btn btn-outline-info btn-sm">
                                    View Registrations
                                </a>

                            </div>

                        </div>
                    </div>
                </div>
            }

        </div>
    }

</div>
