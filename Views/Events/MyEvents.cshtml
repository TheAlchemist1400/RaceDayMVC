@model List<RaceDay.Mvc.ViewModels.EventViewModel>

@{
    ViewData["Title"] = "My Events";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["Success"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

        
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show"
                 role="alert">

                @TempData["Error"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        }

        <div>
            <h1>My Events</h1>
            <p class="text-muted">
                Manage the events published by your organization.
            </p>
        </div>

        <a asp-controller="Events"
           asp-action="Create"
           class="btn btn-primary">
            Create New Event
        </a>
    </div>

    <hr />

    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            <h5>No events found</h5>
            <p class="mb-0">
                You haven't published any events yet.
                Create your first event to get started.
            </p>
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var eventItem in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">

                    <div class="card shadow-sm h-100">

                        @if (!string.IsNullOrWhiteSpace(eventItem.BannerImageUrl))
                        {
                            <img src="@Url.Action("Banner", "Events",
                                          new { id = eventItem.EventId })"
                                 class="card-img-top"
                                 alt="Banner for @eventItem.EventsName"
                                 style="height: 200px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light border-bottom
                                d-flex align-items-center justify-content-center"
                                 style="height: 200px;">

                                <span class="text-muted">
                                    No Event Banner
                                </span>

                            </div>
                        }

                        <div class="card-body">

                            <h5 class="card-title">
                                @eventItem.EventsName
                            </h5>

                            <hr />

                            <p>
                                <strong>Date:</strong>
                                @eventItem.EventDate.ToString("dd MMMM yyyy")
                            </p>

                            <p>
                                <strong>Venue:</strong>
                                @eventItem.Location
                            </p>

                            <p>
                                <strong>City:</strong>
                                @eventItem.City, @eventItem.Province
                            </p>

                            <p>
                                <strong>Maximum Participants:</strong>
                                @eventItem.MaxParticipants
                            </p>

                            <div class="d-flex gap-2">

                                <a asp-controller="Events"
                                   asp-action="Edit"
                                   asp-route-id="@eventItem.EventId"
                                   class="btn btn-outline-primary btn-sm">
                                    Edit
                                </a>

                                <a asp-controller="Activities"
                                   asp-action="Create"
                                   asp-route-eventId="@eventItem.EventId"
                                   class="btn btn-outline-success btn-sm">
                                    Add Activity
                                </a>

                                <a asp-controller="Events"
                                   asp-action="Delete"
                                   asp-route-id="@eventItem.EventId"
                                   class="btn btn-outline-danger btn-sm">
                                    Delete
                                </a>

                                
                                <a asp-controller="Enrolments"
                                   asp-action="EventRegistrations"
                                   asp-route-id="@eventItem.EventId"
                                   class="btn btn-outline-info btn-sm">
                                    View Registrations
                                </a>

                                
                                <hr />

                                <h6 class="mt-3">Event Banner</h6>

                                <form asp-controller="Events"
                                      asp-action="UploadBanner"
                                      asp-route-id="@eventItem.EventId"
                                      method="post"
                                      enctype="multipart/form-data">

                                    @Html.AntiForgeryToken()

                                    <div class="mb-2">
                                        <input type="file"
                                               name="file"
                                               accept=".jpg,.jpeg,.png,.webp"
                                               class="form-control form-control-sm"
                                               required />
                                    </div>

                                    <button type="submit"
                                            class="btn btn-outline-primary btn-sm w-100">

                                        @(string.IsNullOrWhiteSpace(eventItem.BannerImageUrl)
                                            ? "Upload Banner"
                                            : "Replace Banner")

                                    </button>
                                </form>

                                <small class="text-muted d-block mt-2">
                                    JPG, PNG or WebP. Maximum size: 5 MB.
                                </small>


                            </div>

                        </div>
                    </div>
                </div>
            }

        </div>
    }

</div>
