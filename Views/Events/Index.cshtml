@model List<RaceDay.Mvc.ViewModels.EventViewModel>

@{
    ViewData["Title"] = "Browse Events";
}

<div class="container mt-4">

    <div class="mb-4">
        <h1>Discover Events</h1>
        <p class="text-muted">
            Explore upcoming events and find your next challenge.
        </p>
    </div>

    <hr />

    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No events are currently available.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var eventItem in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">

                    <div class="card shadow-sm h-100">

                        @if (!string.IsNullOrWhiteSpace(eventItem.BannerImageUrl))
                        {
                            <img src="@Url.Action("Banner", "Events",
                                          new { id = eventItem.EventId })"
                                 class="card-img-top"
                                 alt="Banner for @eventItem.EventsName"
                                 style="height: 200px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light border-bottom
                                d-flex align-items-center justify-content-center"
                                 style="height: 200px;">

                                <span class="text-muted">
                                    No Event Banner
                                </span>

                            </div>
                        }

                        <div class="card-body">

                            <h5 class="card-title">
                                @eventItem.EventsName
                            </h5>

                            <hr />

                            <p>
                                <strong>Date:</strong>
                                @eventItem.EventDate.ToString("dd MMMM yyyy")
                            </p>

                            <p>
                                <strong>Venue:</strong>
                                @eventItem.Location
                            </p>

                            <p>
                                <strong>City:</strong>
                                @eventItem.City,
                                @eventItem.Province
                            </p>

                            <p>
                                <strong>Organizer:</strong>
                                @eventItem.Organizer
                            </p>

                            <p>
                                <strong>Maximum Participants:</strong>
                                @eventItem.MaxParticipants
                            </p>

                            <a asp-controller="Events"
                               asp-action="Details"
                               asp-route-id="@eventItem.EventId"
                               class="btn btn-primary w-100">
                                View Details
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>
