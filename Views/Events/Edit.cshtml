@model RaceDay.Mvc.ViewModels.EditEventViewModel

@{
    ViewData["Title"] = "Edit Event";
}

<div class="container mt-4">

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">

            <h1>Manage Event</h1>

            <p class="text-muted">
                Manage event information, banner images and activities.
            </p>

            
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            <hr />

            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <h4 class="mb-3">Event Banner</h4>

                    <p class="text-muted">
                        Upload or replace the banner displayed
                        when Participants browse this event.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(Model.BannerImageUrl))
                    {
                        <img src="@Url.Action("Banner", "Events",
                                      new { id = Model.EventId })"
                             alt="Event banner"
                             class="img-fluid rounded mb-3"
                             style="width: 100%;
                        max-height: 250px;
                        object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-light border rounded
                            d-flex align-items-center justify-content-center
                            mb-3"
                             style="height: 200px;">

                            <span class="text-muted">
                                No Event Banner Uploaded
                            </span>

                        </div>
                    }

                    <form asp-controller="Events"
                          asp-action="UploadBanner"
                          asp-route-id="@Model.EventId"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label">
                                Select Banner Image
                            </label>

                            <input type="file"
                                   name="file"
                                   accept=".jpg,.jpeg,.png,.webp"
                                   class="form-control"
                                   required />

                            <small class="text-muted">
                                JPG, PNG or WebP. Maximum size: 5 MB.
                            </small>
                        </div>

                        <button type="submit"
                                class="btn btn-outline-primary">

                            @(string.IsNullOrWhiteSpace(Model.BannerImageUrl)
                                ? "Upload Banner"
                                : "Replace Banner")

                        </button>

                    </form>
                </div>
            </div>

            <h4 class="mb-3">Event Details</h4>

            <form asp-controller="Events"
                  asp-action="Edit"
                  asp-route-id="@Model.EventId"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="EventId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="EventsName" class="form-label">
                        Event Name
                    </label>

                    <input asp-for="EventsName" class="form-control" />

                    <span asp-validation-for="EventsName"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="EventDate" class="form-label">
                        Event Date
                    </label>

                    <input asp-for="EventDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="EventDate"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="MaxParticipants" class="form-label">
                        Maximum Participants
                    </label>

                    <input asp-for="MaxParticipants"
                           type="number"
                           min="1"
                           class="form-control" />

                    <span asp-validation-for="MaxParticipants"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-4">
                    <label asp-for="LocationId" class="form-label">
                        Event Location
                    </label>

                    <select asp-for="LocationId" class="form-select">

                        <option value="0">
                            -- Select a location --
                        </option>

                        @foreach (var location in Model.Locations)
                        {
                            <option value="@location.LocationId">
                                @location.Venue - @location.City,
                                @location.Province
                            </option>
                        }

                    </select>

                    <span asp-validation-for="LocationId"
                          class="text-danger">
                    </span>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit" class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-controller="Events"
                       asp-action="MyEvents"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>
            </form>

            <hr class="my-4" />

            <hr class="my-4" />

            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <h4>Event Activities</h4>

                    <p class="text-muted">
                        Manage the activities available for this event.
                    </p>

                    <a asp-controller="Activities"
                       asp-action="Create"
                       asp-route-eventId="@Model.EventId"
                       class="btn btn-outline-success">

                        Add Activity
                    </a>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
