@model List<RaceDay.Mvc.ViewModels.EventRegistrationViewModel>

@{
    ViewData["Title"] = "Event Registrations";

    int eventId = ViewBag.EventId;
    int total = Model.Count;
    int confirmed = Model.Count(r =>
        r.RegistrationStatus == "Confirmed");
    int pending = Model.Count(r =>
        r.RegistrationStatus == "Pending");
    int cancelled = Model.Count(r =>
        r.RegistrationStatus == "Cancelled");
}

<div class="container mt-4">

    <a asp-controller="Events"
       asp-action="MyEvents"
       class="btn btn-outline-secondary mb-4">
        Back to My Events
    </a>

    <h1>Event Registrations</h1>

    <p class="text-muted">
        Manage Participants registered for your event.
    </p>

    <hr />

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- Registration statistics -->
    <div class="row mb-4">

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>Total Registrations</h6>
                    <h2>@total</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>Confirmed</h6>
                    <h2 class="text-success">@confirmed</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>Pending</h6>
                    <h2 class="text-warning">@pending</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>Cancelled</h6>
                    <h2 class="text-danger">@cancelled</h2>
                </div>
            </div>
        </div>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No Participants have registered for this event yet.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Participant</th>
                        <th>Email</th>
                        <th>Activity</th>
                        <th>Bib Number</th>
                        <th>Date</th>
                        <th>Results</th>
                        <th>Status</th>
                        <th>Manage Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var registration in Model)
                    {
                        <tr>
                            <td>@registration.ParticipantName</td>

                            <td>@registration.ParticipantEmail</td>

                            <td>@registration.ActivityName</td>

                            <td>
                                <strong>#@registration.BibNumber</strong>
                            </td>

                            <td>
                                @registration.RegistrationDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @if (registration.RegistrationStatus == "Confirmed")
                                {
                                    <span class="badge bg-success">
                                        Confirmed
                                    </span>
                                }
                                else if (registration.RegistrationStatus == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }
                                else if (registration.RegistrationStatus == "Cancelled")
                                {
                                    <span class="badge bg-danger">
                                        Cancelled
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @registration.RegistrationStatus
                                    </span>
                                }
                            </td>

                            <td>
                                <form asp-controller="Enrolments"
                                      asp-action="UpdateStatus"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <!-- Identify the registration -->
                                    <input type="hidden"
                                           name="RegistrationId"
                                           value="@registration.RegistrationId" />

                                    <!-- Used to return to this event -->
                                    <input type="hidden"
                                           name="EventId"
                                           value="@eventId" />

                                    <div class="d-flex gap-2">

                                        <select name="RegistrationStatus"
                                                class="form-select form-select-sm"
                                                required>

                                            <option value="Pending"
                                                    selected="@(registration.RegistrationStatus == "Pending")">
                                                Pending
                                            </option>

                                            <option value="Confirmed"
                                                    selected="@(registration.RegistrationStatus == "Confirmed")">
                                                Confirmed
                                            </option>

                                            <option value="Cancelled"
                                                    selected="@(registration.RegistrationStatus == "Cancelled")">
                                                Cancelled
                                            </option>

                                        </select>

                                        <button type="submit"
                                                class="btn btn-primary btn-sm">
                                            Update
                                        </button>

                                    </div>

                                </form>
                            </td>

                            <td>
                                @if (registration.RegistrationStatus == "Confirmed")
                                {
                                    <a asp-controller="Results"
                                       asp-action="Capture"
                                       asp-route-id="@registration.RegistrationId"
                                       asp-route-eventId="@eventId"
                                       class="btn btn-outline-success btn-sm">
                                        Capture Result
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not eligible
                                    </span>
                                }
                            </td>


                        </tr>
                    }
                </tbody>

            </table>

        </div>
    }

</div>
